# Copy to .env.local for local dev (`vercel dev`) and set the same keys in the
# Vercel dashboard (Project → Settings → Environment Variables) for production.
# NEVER commit real values. .env*.local is gitignored.

# --- GitHub (opens the pull requests) ---
# Fine-grained PAT on the conference repo with: Contents R/W + Pull requests R/W
GITHUB_TOKEN=
# owner/repo — defaults to rogerSuperBuilderAlpha/algorithmacy-conference if unset
GITHUB_REPO=rogerSuperBuilderAlpha/algorithmacy-conference
# base branch — defaults to main
GITHUB_BASE_BRANCH=main

# --- Email (Mailgun) ---
EMAIL_PROVIDER=mailgun
EMAIL_API_KEY=
EMAIL_DOMAIN=ludwitt.com
EMAIL_FROM=pitchrise@ludwitt.com
# Display name on the confirmation email — set to the conference name
EMAIL_FROM_NAME=Algorithmacy Conference
# Set to https://api.eu.mailgun.net if your Mailgun domain is in the EU region
EMAIL_API_BASE=https://api.mailgun.net

# --- Upstash Redis (pending tokens, 1-per-email index, rate limits) ---
# Auto-injected when you add Upstash from the Vercel Marketplace
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Site ---
SITE_URL=https://algorithmacy.org

# --- Studio portal (Firebase project: cursor-boston, same as cohorts) ---
# Service account JSON, one line. Server only. Never commit it.
FIREBASE_SERVICE_ACCOUNT_JSON=
# Public web config, one JSON line: apiKey, authDomain, projectId, appId.
# algorithmacy.org and www.algorithmacy.org are authorized domains on cursor-boston.
# Email/password and Google are already enabled there. The portal sends its own email link through Mailgun.
FIREBASE_WEB_CONFIG=
# Comma-separated fallback for admin, until the studioAdmin claim is set
# with: node scripts/set-studio-admin.js roger@algorithmacy.org
STUDIO_ADMIN_EMAILS=roger@algorithmacy.org
# Seals authenticator secrets and backup-code hashes. A long random string.
# If unset, the server derives this from FIREBASE_SERVICE_ACCOUNT_JSON.
STUDIO_MFA_KEY=
# HTTPS hosts that may receive an assistant sign-in. Localhost is always allowed.
# Add a host here before connecting an assistant whose callback is not listed.
STUDIO_OAUTH_REDIRECT_HOSTS=claude.ai,cursor.com
# Video link included in booking confirmations. Optional.
STUDIO_MEET_URL=
# Vercel sends this on cron invocations. Generate a long random string.
CRON_SECRET=

# --- Studio billing (Stripe) ---
# Create the two prices with: node scripts/create-stripe-prices.js
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SETUP=
STRIPE_PRICE_MONTHLY=
