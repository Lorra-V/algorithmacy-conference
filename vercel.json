{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "algorithmacy.com" }],
      "destination": "https://algorithmacy.org/studio",
      "statusCode": 301
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.algorithmacy.com" }],
      "destination": "https://algorithmacy.org/studio",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "algorithmacy.com" }],
      "destination": "https://algorithmacy.org/$1",
      "statusCode": 301
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.algorithmacy.com" }],
      "destination": "https://algorithmacy.org/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    { "source": "/api/portal/(.+)", "destination": "/api/portal?path=$1" },
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/oauth-metadata?doc=as" },
    { "source": "/.well-known/oauth-authorization-server/(.*)", "destination": "/api/oauth-metadata?doc=as" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/oauth-metadata?doc=resource" },
    { "source": "/.well-known/oauth-protected-resource/(.*)", "destination": "/api/oauth-metadata?doc=resource" }
  ],
  "crons": [
    { "path": "/api/cron?job=reminders", "schedule": "*/15 * * * *" },
    { "path": "/api/cron?job=digest", "schedule": "0 12 * * 1" },
    { "path": "/api/cron?job=reports", "schedule": "0 13 1 * *" }
  ]
}
